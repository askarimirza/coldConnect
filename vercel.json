{
  "version": 2,
  "builds": [
    {
      "src": "*.php",
      "use": "vercel-php@latest"
    },
    {
      "src": "owner/*.php",
      "use": "vercel-php@latest"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}